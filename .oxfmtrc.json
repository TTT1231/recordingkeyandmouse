{
    "ignorePatterns": [
        "dist",
        "node_modules",
        "coverage",
        "public",
        "src-tauri/target",
        "src-tauri/gen",
        "src-tauri/icons",
        "**/*.svg",
        "**/*.sh",
        "*-lock.yaml"
    ],
    "semi": true,
    "trailingComma": "all",
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "quoteProps": "as-needed",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "avoid",
    "endOfLine": "lf"
}
